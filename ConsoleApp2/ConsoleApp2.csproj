<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>CybersecurityChatbot</RootNamespace>
		<AssemblyName>CybersecurityChatbot</AssemblyName>
		<StartupObject>CybersecurityChatbot.Program</StartupObject>
		<Version>2.0.0</Version>
		<Authors>Ramadi Ndivhuwo</Authors>
		<Description>Cybersecurity Awareness Chatbot</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Update="greeting.wav">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>