<Window x:Class="CybersecurityChatbot.ChatbotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot" 
        Height="720" 
        Width="820"
        Background="#1e1e2e"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1e1e2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="#2d2d44" Margin="0,0,0,10">
            <TextBlock Text="╔═══════════════════════════════════════╗" 
                       Foreground="#00ff88" FontFamily="Courier New" FontSize="12" TextAlignment="Center"/>
            <TextBlock Text="║  CYBERSECURITY AWARENESS BOT BY RAMADI NDIVHUWO  ║" 
                       Foreground="#00ff88" FontFamily="Courier New" FontSize="12" TextAlignment="Center" Margin="0,2,0,2"/>
            <TextBlock Text="╚═══════════════════════════════════════╝" 
                       Foreground="#00ff88" FontFamily="Courier New" FontSize="12" TextAlignment="Center"/>

            <TextBlock Text="Welcome to Your Cybersecurity Assistant" 
                       Foreground="WhiteSmoke" FontSize="18" FontWeight="Bold" Margin="0,15,0,5" TextAlignment="Center"/>
            <TextBlock Text="Learn essential tips to help you stay safe online." 
                       Foreground="#b0b0ff" FontSize="13" Margin="0,0,0,15" TextAlignment="Center"/>
        </StackPanel>

        <!-- Chat Display -->
        <Border Grid.Row="1" Background="#1a1a24" CornerRadius="8" Margin="12" BorderBrush="#00ff88" BorderThickness="2">
            <RichTextBox x:Name="ChatDisplay" 
                         Background="#1a1a24" 
                         Foreground="#e0e0e0"
                         IsReadOnly="True"
                         Margin="8"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="14"/>
        </Border>

        <!-- Input Section -->
        <StackPanel Grid.Row="2" Background="#2d2d44" Margin="12,0,12,12">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Your Name:" Foreground="#87ceeb" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBox x:Name="UserNameInput" Background="#1a1a24" Foreground="#ffffff" Padding="8" Width="180" Margin="0,0,8,0"/>
                <Button x:Name="SetNameButton" Content="Set Name" Background="#00ff88" Foreground="#1e1e2e"
                        Padding="12,6" FontWeight="Bold" Click="SetNameButton_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="NameStatusBlock" Foreground="#00ff88" VerticalAlignment="Center" FontStyle="Italic"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="UserInput" Background="#1a1a24" Foreground="#ffffff" Padding="12" Height="48"
                         VerticalContentAlignment="Center" FontSize="14" KeyDown="UserInput_KeyDown" Margin="0,0,8,0"/>
                <Button x:Name="SendButton" Content="Send" Background="#ff4757" Foreground="White"
                        Padding="20,6" FontWeight="Bold" Width="90" Click="SendButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="ClearButton" Content="Clear Chat" Background="#4ecdc4" Foreground="White"
                        Padding="12,6" Click="ClearButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quick Topics:" Foreground="#ffb347" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Password" Background="#6c5ce7" Foreground="White" Padding="10,4" Tag="password" Click="QuickTopic_Click" Margin="0,0,6,0"/>
                <Button Content="Phishing" Background="#a29bfe" Foreground="White" Padding="10,4" Tag="phishing" Click="QuickTopic_Click" Margin="0,0,6,0"/>
                <Button Content="Privacy" Background="#74b9ff" Foreground="White" Padding="10,4" Tag="privacy" Click="QuickTopic_Click" Margin="0,0,6,0"/>
                <Button Content="Malware" Background="#fd79a8" Foreground="White" Padding="10,4" Tag="malware" Click="QuickTopic_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>